ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Session signing secret (required) — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-char-string

# Supabase (required)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: cutoff time for submissions, ISO format. Leave unset for no limit.
# SUBMIT_DEADLINE=2026-06-20T23:59:59+08:00

# Optional: confirmation email via Resend (https://resend.com). Free tier available.
# Leave RESEND_API_KEY unset to run in dev mode (emails are logged to console only).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=onboarding@resend.dev
